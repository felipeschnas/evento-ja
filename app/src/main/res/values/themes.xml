<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.EventoJa" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_brand_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/on_brand_secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>

        <!-- Barra de titulo (action bar) na cor do app, usada em todas as telas -->
        <item name="actionBarStyle">@style/Widget.EventoJa.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
        <!-- Barra de status na cor do app, com icones brancos -->
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- No Android 15+ o conteudo ficava por baixo da barra de titulo (edge-to-edge).
             Assim as telas comecam abaixo da barra, como nas versoes anteriores. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="Widget.EventoJa.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/brand_primary</item>
        <item name="titleTextStyle">@style/TextAppearance.EventoJa.ActionBar.Title</item>
        <item name="subtitleTextStyle">@style/TextAppearance.EventoJa.ActionBar.Subtitle</item>
    </style>

    <style name="TextAppearance.EventoJa.ActionBar.Title" parent="TextAppearance.Material3.ActionBar.Title">
        <item name="android:textColor">@color/on_brand_primary</item>
    </style>

    <style name="TextAppearance.EventoJa.ActionBar.Subtitle" parent="TextAppearance.Material3.ActionBar.Subtitle">
        <item name="android:textColor">@color/on_brand_primary</item>
    </style>
</resources>
